# Copy to deploy/.env on the server and fill in every value.

# The server's public address, without https://. Point a DNS record at the server's IP, or use the
# free sslip.io name made from the IP with dashes, e.g. 203-0-113-7.sslip.io for 203.0.113.7.
INHIBITAI_DOMAIN=

# Database password: letters and digits only, because it goes into a URL.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. Generate one with:  openssl rand -hex 32
INHIBITAI_JWT_SECRET=

# Who may create an account: emails and/or @domains, comma-separated, e.g.
#   @sharjah.ac.ae, supervisor@gmail.com
# Leave empty only if anyone who finds the address should be able to sign up.
INHIBITAI_ALLOWED_SIGNUP_EMAILS=

# Optional: password reset emails (DEPLOY.md section 4). Leave empty to switch password reset off.
INHIBITAI_SMTP_HOST=
INHIBITAI_SMTP_PORT=587
INHIBITAI_SMTP_USERNAME=
INHIBITAI_SMTP_PASSWORD=
INHIBITAI_SMTP_FROM=

# Optional: "Continue with Google" (DEPLOY.md section 5). The OAuth *web* client ID.
INHIBITAI_GOOGLE_CLIENT_IDS=
