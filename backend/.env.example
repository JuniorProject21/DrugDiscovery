# Copy this file to backend/.env and fill it in. Every setting can also be an environment variable.

# Database layer: PostgreSQL (the RDKit cartridge is used automatically when installed).
# Leave unset to use a local SQLite file (backend/inhibitai.db) for quick experiments.
INHIBITAI_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/inhibitai

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INHIBITAI_JWT_SECRET=

# The trained model exported with scripts/export_model_bundle.py (default: backend/models/parp1_bundle.joblib)
# INHIBITAI_MODEL_BUNDLE_PATH=/absolute/path/to/parp1_bundle.joblib

# Who may create an account: emails and/or @domains, comma-separated. Empty = anyone.
# INHIBITAI_ALLOWED_SIGNUP_EMAILS=@sharjah.ac.ae, supervisor@example.com

# Password reset emails. Without these, development mode prints the codes in this terminal.
# INHIBITAI_SMTP_HOST=smtp.gmail.com
# INHIBITAI_SMTP_USERNAME=you@gmail.com
# INHIBITAI_SMTP_PASSWORD=your-app-password
# INHIBITAI_SMTP_FROM=InhibitAI <you@gmail.com>

# "Continue with Google": the OAuth web client ID (see ../DEPLOY.md section 5).
# INHIBITAI_GOOGLE_CLIENT_IDS=1234-abc.apps.googleusercontent.com

# Until the trained model is exported, let the app run against a clearly labelled placeholder.
# Every placeholder result is marked "stub" in the API and in the app. Remove this once the bundle exists.
INHIBITAI_ALLOW_STUB_MODEL=true

# Must match the preprocessing used in training (tautomer canonicalisation was on in the progress report).
# INHIBITAI_TAUTOMER_CANONICALIZATION=true
